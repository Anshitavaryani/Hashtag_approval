# Copy to .env.local and fill in. Every NEXT_PUBLIC_ value is compiled into the
# page that customers download, so never put a secret here. The Deploy workflow
# sets its own values in its Build step (.github/workflows/deploy.yml).

# Required. Backend API root, including /api/v1/ and the trailing slash.
# Production: https://node.hashtagbillionaire.com/api/v1/
# Local backend (PORT in its .env): http://localhost:5050/api/v1/
NEXT_PUBLIC_API_URL=http://localhost:5050/api/v1/

# Optional. The path the site is served under. Defaults to /approval
# (https://hashtagbillionaire.com/approval/). Set it to nothing (NEXT_PUBLIC_BASE_PATH=)
# when the site has its own subdomain and is served from its root.
NEXT_PUBLIC_BASE_PATH=/approval

